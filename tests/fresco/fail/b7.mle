type list a = Nil | Cons of a, list a

val head : forall a . list a -> a
val map : forall a b . (a -> b) -> list a -> list b
val ids : list (forall a . a -> a)
val single : forall a . a -> list a

let infer = map head (single ids)

-- Church-encoded lists (B7).

val churchHead : forall a .
  (forall b . b -> (a -> b -> b) -> b) -> a
val churchMap : forall a b . (a -> b) ->
  (forall c . c -> (a -> c -> c) -> c) ->
  (forall c . c -> (b -> c -> c) -> c)
val churchSingle : forall a . a ->
  (forall b . b -> (a -> b -> b) -> b)
val churchIds : forall b . b -> ((forall a . a -> a) -> b -> b) -> b

let inferChurch = churchMap churchHead (churchSingle churchIds)
