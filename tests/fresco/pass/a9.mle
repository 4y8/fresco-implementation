type list a = Nil | Cons of a, list a

val f : forall a . (a -> a) -> list a -> a
val id : forall a . a -> a
val choose : forall a . a -> a -> a
val ids : list (forall a . a -> a)

let infer = f (choose id) ids

-- val check : forall a . (a -> a)
-- let check = f (choose id) ids

-- Church-encoded lists (A9).

val churchF : forall a . (a -> a) ->
  (forall b . b -> (a -> b -> b) -> b) -> a
val churchIds : forall b . b -> ((forall a . a -> a) -> b -> b) -> b

let inferChurch = churchF (choose id) churchIds
