type bool = True | False
type list a = Nil | Cons of a, list a

val ids : list (forall a . a -> a)
val head : forall a . list a -> a
val true : bool

let infer = head ids true

-- Church-encoded lists (B8).

val churchIds : forall b . b -> ((forall a . a -> a) -> b -> b) -> b
val churchHead : forall a .
  (forall b . b -> (a -> b -> b) -> b) -> a

let inferChurch = churchHead churchIds true
